<lm:LmView x:Class="AxionConnect.Wpf.Views.EngenhariaView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
           xmlns:ctl="clr-namespace:AxionConnect.Wpf.Controls"
           Titulo="Engenharia de Produto"
           MostrarBotaoFechar="False"
           FecharComEsc="False">

  <lm:LmView.Resources>
    <!-- Bloco "rótulo / valor" da faixa de informações do componente -->
    <Style x:Key="BlocoInfo" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,28,6" />
      <Setter Property="MaxWidth" Value="420" />
    </Style>

    <!-- Ícone da barra do visualizador (fonte de ícones do Windows), no tamanho das imagens 20x20 -->
    <Style x:Key="IconeBarra" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,2,0,0" />
    </Style>
  </lm:LmView.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="360" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="520" MinWidth="420" />
    </Grid.ColumnDefinitions>

    <!-- ============ ÁREA DO DESENHO ============ -->
    <Grid Margin="0,0,6,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Informações do componente selecionado (flpInfos) -->
      <Border x:Name="CartaoInfo" Style="{StaticResource Cartao}" Padding="14,10,14,4"
              Visibility="{Binding ProdutoSelecionado, Converter={StaticResource NullToVisibility}}">
        <WrapPanel>
          <StackPanel Style="{StaticResource BlocoInfo}">
            <TextBlock Text="Código Produto" Style="{StaticResource RotuloCampo}" />
            <Button Command="{Binding CopiarCodigoCommand}" ToolTip="Clique para copiar" Cursor="Hand" Focusable="False">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock Text="{Binding ProdutoSelecionado.CodProduto}" Style="{StaticResource InfoValor}"
                               Foreground="{DynamicResource {x:Static lm:LmCor.Bc_Header}}" />
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource FonteIcones}" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static lm:LmCor.Bc_Header}}" />
                  </StackPanel>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
          <StackPanel Style="{StaticResource BlocoInfo}">
            <TextBlock Text="Nome" Style="{StaticResource RotuloCampo}" />
            <TextBlock Text="{Binding ProdutoSelecionado.Name}" Style="{StaticResource InfoValor}" />
          </StackPanel>
          <StackPanel Style="{StaticResource BlocoInfo}">
            <TextBlock Text="Denominação" Style="{StaticResource RotuloCampo}" />
            <TextBlock Text="{Binding ProdutoSelecionado.Denominacao}" Style="{StaticResource InfoValor}" />
          </StackPanel>
          <StackPanel Style="{StaticResource BlocoInfo}" Visibility="{Binding Dimensao, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="Dimensão" Style="{StaticResource RotuloCampo}" />
            <TextBlock Text="{Binding Dimensao}" Style="{StaticResource InfoValor}" />
          </StackPanel>
          <StackPanel Style="{StaticResource BlocoInfo}" Visibility="{Binding Material, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="Material" Style="{StaticResource RotuloCampo}" />
            <TextBlock Text="{Binding Material}" Style="{StaticResource InfoValor}" />
          </StackPanel>
          <StackPanel Style="{StaticResource BlocoInfo}">
            <TextBlock Text="Peso" Style="{StaticResource RotuloCampo}" />
            <TextBlock Text="{Binding Peso}" Style="{StaticResource InfoValor}" />
          </StackPanel>
        </WrapPanel>
      </Border>

      <!-- Barra do visualizador (os botões não podem ficar sobre o desenho: o ActiveX cobre o WPF) -->
      <StackPanel x:Name="BarraVisualizador" Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6" Visibility="Collapsed">
        <lm:LmButton x:Name="BtnAlternar" Estilo="Gray" Padding="6,0" Margin="0,0,4,0" Click="BtnAlternar_Click">
          <Image x:Name="ImgAlternar" Width="20" Height="20" />
        </lm:LmButton>
        <lm:LmButton x:Name="BtnPdf" Estilo="Gray" Padding="6,0" Margin="0,0,4,0" Click="BtnPdf_Click" ToolTip="Abrir PDF">
          <!-- Folha com a etiqueta vermelha "PDF" (desenhada aqui: não há ícone de PDF nos Assets) -->
          <Viewbox Width="20" Height="20">
            <Canvas Width="20" Height="20">
              <Path Fill="White" Data="M4,1 H12 L17,6 V19 H4 Z" />
              <Path Fill="#D0D0D0" Data="M12,1 V6 H17 Z" />
              <Border Canvas.Left="1" Canvas.Top="9" Width="15" Height="7.5" Background="#D32F2F" CornerRadius="1">
                <TextBlock Text="PDF" FontSize="5.6" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Canvas>
          </Viewbox>
        </lm:LmButton>
        <!-- Botões que só fazem sentido no eDrawings (somem com o PDF na tela) -->
        <StackPanel x:Name="BotoesEDrawings" Orientation="Horizontal">
          <lm:LmButton x:Name="BtnProximaFolha" Estilo="Gray" Padding="6,0" Margin="0,0,4,0" Click="BtnProximaFolha_Click" ToolTip="Próxima folha">
            <Image x:Name="ImgProximaFolha" Width="20" Height="20" />
          </lm:LmButton>
          <lm:LmButton Estilo="Gray" Padding="6,0" Margin="0,0,4,0" Click="BtnPosicaoInicial_Click" ToolTip="Posição inicial (ajustar visualização)">
            <TextBlock Text="&#xE80F;" Style="{StaticResource IconeBarra}" />
          </lm:LmButton>

          <!-- Ferramentas do mouse: a ativa fica destacada; clicar de novo volta ao Selecionar (Tag = EMVOperators) -->
          <lm:LmButton x:Name="BtnZoomArea" Tag="eMVOperatorZoomToArea" Estilo="Gray" Padding="6,0" Margin="8,0,4,0"
                       Click="BtnFerramenta_Click" ToolTip="Zoom por área">
            <TextBlock Text="&#xE8A3;" Style="{StaticResource IconeBarra}" />
          </lm:LmButton>
          <lm:LmButton x:Name="BtnZoomContinuo" Tag="eMVOperatorZoom" Estilo="Gray" Padding="6,0" Margin="0,0,4,0"
                       Click="BtnFerramenta_Click" ToolTip="Zoom contínuo (arraste para aproximar/afastar)">
            <TextBlock Text="&#xE71E;" Style="{StaticResource IconeBarra}" />
          </lm:LmButton>
          <lm:LmButton x:Name="BtnGirar" Tag="eMVOperatorRotate" Estilo="Gray" Padding="6,0" Margin="0,0,4,0"
                       Click="BtnFerramenta_Click" ToolTip="Girar">
            <TextBlock Text="&#xE7AD;" Style="{StaticResource IconeBarra}" />
          </lm:LmButton>
          <lm:LmButton x:Name="BtnMover" Tag="eMVOperatorPan" Estilo="Gray" Padding="6,0" Margin="0,0,4,0"
                       Click="BtnFerramenta_Click" ToolTip="Mover">
            <!-- Quatro setas (desenhadas aqui: o glifo "Move" da fonte de ícones não aparece em todas as versões do Windows) -->
            <Path Width="20" Height="20" StrokeThickness="1.4" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                  Data="M10,3 V17 M3,10 H17 M7.5,5.5 L10,3 L12.5,5.5 M7.5,14.5 L10,17 L12.5,14.5 M5.5,7.5 L3,10 L5.5,12.5 M14.5,7.5 L17,10 L14.5,12.5" />
          </lm:LmButton>
        </StackPanel>
        <TextBlock x:Name="TxtFolha" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource TextoDica}" FontSize="12" />
      </StackPanel>

      <Border x:Name="AreaDesenho" Grid.Row="2" BorderThickness="1" ClipToBounds="True"
              BorderBrush="{DynamicResource {x:Static lm:LmCor.Bc_Btn_Disabled}}"
              Background="{DynamicResource {x:Static lm:LmCor.Bc_Txt_Normal}}">
        <Grid>
          <TextBlock Text="Informe o código de engenharia para carregar os componentes e visualizar o desenho."
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                     Style="{StaticResource TextoDica}" FontSize="13" />
          <!-- Visibilidade controlada no code-behind (AtualizarVisibilidadeViewer) -->
          <ctl:EDrawingsViewer x:Name="Viewer" />
          <!-- Mesmo lugar do eDrawings; os dois ficam carregados e só um aparece por vez -->
          <ctl:PdfViewer x:Name="VisualizadorPdf" Visibility="Hidden" />
        </Grid>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" />

    <!-- ============ PAINEL DIREITO ============ -->
    <Grid Grid.Column="2" Margin="6,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Código da engenharia e ações principais (pnlDados) -->
      <Border Style="{StaticResource Cartao}" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="Código Engenharia" Style="{StaticResource RotuloCampo}" />
            <lm:LmTextBox x:Name="TxtCodigo" Text="{Binding CodigoEngenharia, UpdateSourceTrigger=PropertyChanged}"
                          Valor="Num_Inteiro" Watermark="Código da engenharia no ERP (Enter carrega)"
                          IsReadOnly="{Binding CodigoBloqueado}" FontSize="15" Height="32"
                          GotKeyboardFocus="TxtCodigo_GotKeyboardFocus" LostKeyboardFocus="TxtCodigo_LostKeyboardFocus"
                          PreviewKeyDown="TxtCodigo_PreviewKeyDown" />
          </StackPanel>

          <lm:LmButton x:Name="BtnSalvar" Grid.Row="2" Content="Salvar Engenharia" Icone="&#xE74E;"
                       Command="{Binding SalvarCommand}" IsEnabled="{Binding BotoesHabilitados}"
                       ToolTip="Envia ao ERP a engenharia do componente selecionado e de todos os seus filhos" />
          <lm:LmButton x:Name="BtnNova" Grid.Row="2" Grid.Column="2" Content="Nova Engenharia" Icone="&#xE710;" Estilo="Gray"
                       Command="{Binding NovaEngenhariaCommand}" IsEnabled="{Binding BotoesHabilitados}" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1">
        <!-- Carregamento das operações e máquinas do ERP -->
        <Border Style="{StaticResource Cartao}" Margin="0,8,0,0" Padding="10,6"
                Visibility="{Binding CarregandoCadastros, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="Carregando operações e máquinas do ERP..." Style="{StaticResource RotuloCampo}" Margin="0" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" BorderThickness="0"
                         Foreground="{DynamicResource {x:Static lm:LmCor.Bc_Header}}"
                         Background="{DynamicResource {x:Static lm:LmCor.Bc_Txt_Disabled}}" />
          </StackPanel>
        </Border>

        <!-- Pendências do componente (lblWarning) -->
        <Border x:Name="FaixaPendencias" Margin="0,8,0,0" Visibility="{Binding Alerta, Converter={StaticResource NullToVisibility}}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource FaixaAlerta}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding AlertaCritico}" Value="True">
                  <Setter Property="Background" Value="#FDECEA" />
                  <Setter Property="BorderBrush" Value="#F44336" />
                  <Setter Property="TextElement.Foreground" Value="#8E1B13" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource FonteIcones}" FontSize="16" Margin="0,1,10,0" />
            <TextBlock Text="{Binding Alerta}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- Abas -->
      <lm:LmTabControl x:Name="Abas" Grid.Row="2" Margin="0,8,0,0">

        <!-- Componentes -->
        <TabItem Header="Componentes">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource TextoDica}"
                         Text="{Binding Produtos.Count, StringFormat='{}{0} componentes'}" />
              <lm:LmTextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged, Delay=250}" Height="30"
                            Watermark="Procurar por nível, nome, código, descrição ou referência..."
                            MostrarBotaoLimpar="True" />
            </DockPanel>

            <lm:LmDataGrid x:Name="Grade" ItemsSource="{Binding ProdutosView}" SelectedItem="{Binding ProdutoSelecionado}"
                           AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                           HeadersVisibility="Column" RowStyle="{StaticResource LinhaComponente}"
                           CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                           CanUserAddRows="False" CanUserDeleteRows="False"
                           TextoSemRegistros="Nenhum componente carregado."
                           SelectionChanged="Grade_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><Image Source="{Binding Img3D, Converter={StaticResource BitmapParaImagem}}" Width="16" Height="16" ToolTip="Abrir 3D" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="30">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><Image Source="{Binding Img2D, Converter={StaticResource BitmapParaImagem}}" Width="16" Height="16" ToolTip="Abrir 2D" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="30">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><Image Source="{Binding ImgFantasma, Converter={StaticResource BitmapParaImagem}}" Width="16" Height="16" ToolTip="Item Fantasma" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="30">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><Image Source="{Binding ImgPendencia, Converter={StaticResource BitmapParaImagem}}" Width="16" Height="16" ToolTip="{Binding TextoPendencias}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nível" Binding="{Binding Nivel}" Width="60" />
                <DataGridTextColumn Header="Nome Componente" Binding="{Binding Name}" Width="120" />
                <DataGridTextColumn Header="Cód Produto" Binding="{Binding CodProduto}" Width="110" />
                <DataGridTextColumn Header="Descrição Produto" Binding="{Binding Denominacao}" Width="260" />
                <DataGridTextColumn Header="Referência" Binding="{Binding Referencia}" Width="150" />
              </DataGrid.Columns>
            </lm:LmDataGrid>
          </DockPanel>
        </TabItem>

        <!-- Operações -->
        <TabItem Header="Operações">
          <DockPanel>
            <Grid x:Name="FormOperacao" DockPanel.Dock="Top" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource RotuloCampo}">Operação <Run Text="*" Foreground="#D32F2F" /></TextBlock>
                <lm:LmComboBox x:Name="CmbOperacao" ItemsSource="{Binding Operacoes}" DisplayMemberPath="Descricao" SelectedValuePath="Codigo"
                               SelectedValue="{Binding OperacaoSelecionada}" IsEditable="True" IsTextSearchEnabled="True" Height="30"
                               PreviewKeyDown="CmbOperacao_PreviewKeyDown"
                               ToolTip="← / → navegam entre os componentes" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource RotuloCampo}">Máquina <Run Text="*" Foreground="#D32F2F" /></TextBlock>
                <lm:LmComboBox ItemsSource="{Binding Maquinas}" DisplayMemberPath="Descricao" SelectedValuePath="Codigo"
                               SelectedValue="{Binding MaquinaSelecionada}" IsEditable="True" IsTextSearchEnabled="True"
                               IsEnabled="{Binding MaquinaHabilitada}" Height="30" />
              </StackPanel>

              <StackPanel Grid.Row="4">
                <TextBlock Text="Tempo Operação (m:ss)" Style="{StaticResource RotuloCampo}" />
                <lm:LmTextBox Text="{Binding TempoOperacao, UpdateSourceTrigger=PropertyChanged}" Valor="Hora" Height="30" />
              </StackPanel>
              <StackPanel Grid.Row="4" Grid.Column="2">
                <TextBlock Text="QTD Operadores" Style="{StaticResource RotuloCampo}" />
                <lm:LmTextBox Text="{Binding NumeroOperadores, UpdateSourceTrigger=PropertyChanged}" Valor="Num_Inteiro" Height="30" />
              </StackPanel>

              <DockPanel Grid.Row="6" Grid.ColumnSpan="3">
                <lm:LmButton DockPanel.Dock="Right" Icone="&#xE76C;" Padding="8,0" Margin="4,0,0,0"
                             Command="{Binding ProximoCommand}" ToolTip="Próximo componente (→ no campo Operação)" />
                <lm:LmButton DockPanel.Dock="Right" Icone="&#xE76B;" Padding="8,0" Margin="8,0,0,0"
                             Command="{Binding AnteriorCommand}" ToolTip="Componente anterior (← no campo Operação)" />
                <lm:LmCheckBox x:Name="ChkFantasma" DockPanel.Dock="Right" Content="Produto Fantasma" IsChecked="{Binding Fantasma}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                <lm:LmButton Content="Inserir Processo" Icone="&#xE73E;" Command="{Binding InserirOperacaoCommand}" HorizontalAlignment="Left" />
              </DockPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="Arraste os cartões para mudar a ordem das operações."
                       Style="{StaticResource TextoDica}" Margin="0,0,0,6" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ListaOperacoes" ItemsSource="{Binding Cartoes}" AllowDrop="True" Background="Transparent"
                            PreviewMouseLeftButtonDown="Arrastavel_PreviewMouseLeftButtonDown" PreviewMouseMove="ListaOperacoes_PreviewMouseMove"
                            Drop="ListaOperacoes_Drop">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CartaoItem}" Cursor="SizeNS">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" FontFamily="{StaticResource FonteIcones}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Style="{StaticResource TextoDica}" />
                        <lm:LmButton DockPanel.Dock="Right" Icone="&#xE74D;" Estilo="Error" Padding="6,0" MinHeight="26"
                                     ToolTip="Remover operação" Cursor="Hand"
                                     Command="{Binding DataContext.RemoverOperacaoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- Sequência operacional: em qual operação cada filho é consumido -->
        <TabItem Header="Sequência Oper.">
          <Grid>
            <TextBlock Text="Insira operações no componente para definir em qual operação cada item é consumido."
                       TextWrapping="Wrap" Margin="8" FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoDica}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Etapas.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Etapas}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- Um grupo por operação (como os LmGroupBox do FrmEngenharia) -->
                    <lm:LmGroupBox Header="{Binding Titulo}" Margin="0,0,0,8" Padding="6" AllowDrop="True" Drop="Etapa_Drop" MinHeight="70">
                      <ItemsControl ItemsSource="{Binding Produtos}" Background="Transparent" MinHeight="30">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource CartaoItem}" Cursor="SizeAll" Margin="0,0,0,4" CornerRadius="6"
                                    PreviewMouseLeftButtonDown="Arrastavel_PreviewMouseLeftButtonDown" PreviewMouseMove="ProdutoEtapa_PreviewMouseMove">
                              <DockPanel>
                                <lm:LmButton DockPanel.Dock="Right" Icone="&#xE8AB;" Estilo="Gray" Padding="6,0" MinHeight="24"
                                             ToolTip="Mover para outra operação" Click="BtnMoverEtapa_Click" Cursor="Hand"
                                             Visibility="{Binding DataContext.PossuiVariasEtapas, RelativeSource={RelativeSource AncestorType=lm:LmView}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                  <Run Text="{Binding CodProduto, Mode=OneWay}" FontWeight="SemiBold" /> - <Run Text="{Binding Denominacao, Mode=OneWay}" />
                                </TextBlock>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </lm:LmGroupBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!-- Árvore da engenharia do componente -->
        <TabItem Header="Engenharia">
          <TreeView ItemsSource="{Binding ArvoreSelecionada}" Style="{StaticResource ArvoreLm}">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding Expandido, Mode=TwoWay}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static lm:LmCor.Fc_Normal}}" />
                <Setter Property="Padding" Value="2,3" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Filhos}">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icone}" Width="16" Height="16" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding Texto}" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </TabItem>
      </lm:LmTabControl>
    </Grid>

    <!-- ============ PROCESSANDO (Loader do CORE, com Cancelar) ============ -->
    <Grid Grid.ColumnSpan="3" Margin="-10" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}">
      <Rectangle Fill="{DynamicResource {x:Static lm:LmCor.Bc_Form}}" Opacity="0.85" />
      <Border Style="{StaticResource Cartao}" Width="380" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16" BorderThickness="0"
                       Foreground="{DynamicResource {x:Static lm:LmCor.Bc_Header}}"
                       Background="{DynamicResource {x:Static lm:LmCor.Bc_Txt_Disabled}}" />
          <TextBlock Text="{Binding MensagemOcupado}" TextWrapping="Wrap" TextAlignment="Center" MinHeight="40"
                     FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static lm:LmCor.Fc_Normal}}" />
          <lm:LmButton Content="Cancelar" Icone="&#xE711;" Estilo="Gray" HorizontalAlignment="Center" Margin="0,16,0,0"
                       Command="{Binding CancelarCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</lm:LmView>
