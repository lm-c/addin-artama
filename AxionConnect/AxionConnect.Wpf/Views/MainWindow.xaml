<lm:LmWindow x:Class="AxionConnect.Wpf.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
             xmlns:views="clr-namespace:AxionConnect.Wpf.Views"
             Title="{Binding Titulo}" Width="1400" Height="860" MinWidth="1000" MinHeight="600"
             Icon="/AxionConnect;component/Assets/logo_axion_connect.png"
             WindowState="Maximized">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Menu lateral (recolhível, como o pnlMenu do FrmPrincipal) -->
    <Border Background="{DynamicResource {x:Static lm:LmCor.Bc_Header}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="210" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding MenuCompacto}" Value="True">
              <Setter Property="Width" Value="46" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <Button DockPanel.Dock="Top" Style="{StaticResource ItemMenuLateral}" Command="{Binding AlternarMenuCommand}"
                ToolTip="Recolher / expandir menu">
          <TextBlock Text="&#xE700;" FontFamily="{StaticResource FonteIcones}" FontSize="16" />
        </Button>

        <Button DockPanel.Dock="Bottom" Style="{StaticResource ItemMenuLateral}" Click="BtnSair_Click" ToolTip="Sair"
                AutomationProperties.Name="Sair">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource FonteIcones}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Sair" Margin="14,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding MenuCompacto, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </Button>

        <!-- Aparência (cor do tema), logo acima do Sair -->
        <Button x:Name="BtnAparencia" DockPanel.Dock="Bottom" Style="{StaticResource ItemMenuLateral}" Click="BtnAparencia_Click"
                ToolTip="Aparência (cor do sistema)" AutomationProperties.Name="Aparência">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE790;" FontFamily="{StaticResource FonteIcones}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Aparência" Margin="14,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding MenuCompacto, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </Button>

        <StackPanel Margin="0,6,0,0">
          <Button Style="{StaticResource ItemMenuLateral}" ToolTip="Engenharia de Produto" AutomationProperties.Name="Engenharia"
                  Tag="Engenharia" Command="{Binding AbrirTelaCommand}" CommandParameter="Engenharia">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource FonteIcones}" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Engenharia de Produto" Margin="14,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding MenuCompacto, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ItemMenuLateral}" ToolTip="Cadastro de Processo" AutomationProperties.Name="Processos"
                  Tag="Processos" Command="{Binding AbrirTelaCommand}" CommandParameter="Processos"
                  Visibility="{Binding PermiteProcessos, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource FonteIcones}" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Cadastro de Processo" Margin="14,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding MenuCompacto, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- As telas ficam abertas (a Engenharia mantém o desenho e o que foi carregado); o menu só troca a visível. -->
    <views:EngenhariaView Grid.Column="1" DataContext="{Binding Engenharia}"
                          Visibility="{Binding DataContext.EngenhariaVisivel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
    <views:ProcessoCadView Grid.Column="1" DataContext="{Binding Processos}"
                           Visibility="{Binding DataContext.ProcessosVisivel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

    <!-- Rodapé -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="12,3" Background="{DynamicResource {x:Static lm:LmCor.Bc_Header}}">
      <StackPanel Orientation="Horizontal" TextElement.FontSize="11"
                  TextElement.Foreground="{DynamicResource {x:Static lm:LmCor.Fc_Header}}">
        <TextBlock Text="{Binding Usuario, StringFormat='Usuário: {0}'}" Margin="0,0,24,0" />
        <TextBlock Text="{Binding Versao, StringFormat='Versão: {0}'}" Margin="0,0,24,0" />
        <TextBlock Text="{Binding Secao, StringFormat='Seção: {0}'}" Margin="0,0,24,0" />
        <TextBlock Text="{Binding Banco, StringFormat='AMBIENTE DE HOMOLOGAÇÃO ({0})'}" FontWeight="Bold"
                   Visibility="{Binding AmbienteHomologacao, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>
  </Grid>
</lm:LmWindow>
