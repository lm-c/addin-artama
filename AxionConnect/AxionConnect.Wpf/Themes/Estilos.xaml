<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
                    xmlns:conv="clr-namespace:AxionConnect.Wpf.Converters">
  <!--
    Complementos do projeto ao visual da LmCorbieUI.Wpf. Os controles lm:* já trazem o próprio estilo;
    aqui ficam só os elementos do Connect (cartões, menu lateral, faixas de aviso).
    As cores vêm da paleta (LmCor), aplicada pela LmWindow/LmView: sempre DynamicResource.
  -->

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  <conv:IguaisConverter x:Key="Iguais" />
  <conv:BitmapParaImagemConverter x:Key="BitmapParaImagem" />

  <!-- Mesma fonte de ícones dos controles Lm (LmButton.Icone) -->
  <FontFamily x:Key="FonteIcones">Segoe MDL2 Assets</FontFamily>

  <!-- Rótulo acima dos campos -->
  <Style x:Key="RotuloCampo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static lm:LmCor.Fc_Normal}}" />
  </Style>

  <!-- Valor de informação (negrito) -->
  <Style x:Key="InfoValor" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static lm:LmCor.Fc_Normal}}" />
  </Style>

  <!-- Texto secundário (dicas, contadores) -->
  <Style x:Key="TextoDica" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static lm:LmCor.Fc_Watermark}}" />
  </Style>

  <!-- Cartão: área clara com borda suave -->
  <Style x:Key="Cartao" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Txt_Selected}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static lm:LmCor.Bc_Txt_Disabled}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <!-- Cartão de operação / item arrastável (antigo CardOperacao / CardProduto) -->
  <Style x:Key="CartaoItem" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Dgv_CellNormal}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static lm:LmCor.Bc_Btn_Disabled}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static lm:LmCor.Fc_Normal}}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Txt_Disabled}}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Faixas de aviso (mesmas cores do Toast: alerta laranja, erro vermelho) -->
  <Style x:Key="FaixaAlerta" TargetType="Border">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#FFF3E0" />
    <Setter Property="BorderBrush" Value="#FF9800" />
    <Setter Property="TextElement.Foreground" Value="#8A4B00" />
  </Style>

  <Style x:Key="FaixaErro" TargetType="Border" BasedOn="{StaticResource FaixaAlerta}">
    <Setter Property="Background" Value="#FDECEA" />
    <Setter Property="BorderBrush" Value="#F44336" />
    <Setter Property="TextElement.Foreground" Value="#8E1B13" />
  </Style>

  <!-- Item do menu lateral (fundo da cor do cabeçalho, igual ao menu do LmMainForm) -->
  <Style x:Key="ItemMenuLateral" TargetType="Button">
    <Setter Property="Height" Value="44" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static lm:LmCor.Fc_Header}}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="15,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Btn_Selected}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Btn_Press}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Item da tela aberta fica destacado: Tag do botão = MainViewModel.NomeTelaAtual -->
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <MultiBinding Converter="{StaticResource Iguais}">
            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
            <Binding Path="DataContext.NomeTelaAtual" RelativeSource="{RelativeSource AncestorType=Window}" />
          </MultiBinding>
        </DataTrigger.Binding>
        <Setter Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Btn_Selected}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Item de submenu do menu lateral (recuado, texto menor) -->
  <Style x:Key="SubItemMenuLateral" TargetType="Button" BasedOn="{StaticResource ItemMenuLateral}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="44,0,0,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Ações do formulário de cadastro -->
  <Style x:Key="LinhaAcoes" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Margin" Value="0,10,0,10" />
  </Style>

  <!-- Linha da grade de componentes: mesmas regras da LmDataGrid + linha verde quando enviada ao ERP -->
  <Style x:Key="LinhaComponente" TargetType="DataGridRow">
    <Setter Property="MinHeight" Value="26" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Dgv_CellNormal}}" />
      </Trigger>
      <DataTrigger Binding="{Binding Salvo}" Value="True">
        <Setter Property="Foreground" Value="#2E7D32" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- TreeView e ScrollViewer sem estilo Lm: só as cores da paleta -->
  <Style x:Key="ArvoreLm" TargetType="TreeView">
    <Setter Property="Background" Value="{DynamicResource {x:Static lm:LmCor.Bc_Txt_Selected}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static lm:LmCor.Bc_Btn_Disabled}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static lm:LmCor.Fc_Normal}}" />
    <Setter Property="Padding" Value="4" />
  </Style>

</ResourceDictionary>
