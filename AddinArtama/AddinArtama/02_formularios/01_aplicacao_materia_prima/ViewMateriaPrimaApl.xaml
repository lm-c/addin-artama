<lm:LmView x:Class="AddinArtama.ViewMateriaPrimaApl"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
           xmlns:local="clr-namespace:AddinArtama"
           Titulo="Aplicação de Processos/Matéria Prima">
  <lm:LmView.Resources>
    <local:BitmapParaImagemConverter x:Key="BitmapParaImagem" />
    <BooleanToVisibilityConverter x:Key="BoolVisibilidade" />
    <Style x:Key="BotaoIcone" TargetType="{x:Type lm:LmButton}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="Rotulo" TargetType="{x:Type lm:LmLabel}">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="Padding" Value="0,1,6,1" />
    </Style>
    <Style x:Key="Valor" TargetType="{x:Type lm:LmLabel}">
      <Setter Property="Negrito" Value="True" />
      <Setter Property="Padding" Value="0,1" />
    </Style>
  </lm:LmView.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- Dados do componente atual. -->
    <StackPanel x:Name="pnlDados">
      <lm:LmLabel Content="COMPONENTE" Margin="0,0,0,4" />
      <lm:LmTextBox x:Name="txtComponente"
                    Height="30"
                    IconeF7="&#xE895;"
                    ToolTipF7="Atualiza Componente [F7]"
                    IconeF8="&#xE792;"
                    ToolTipF8="Salvar Como, Peça e Montagem [F8]"
                    BotaoF7Click="TxtComponente_BotaoF7Click"
                    BotaoF8Click="TxtComponente_BotaoF8Click"
                    TextChanged="TxtComponente_TextChanged" />

      <lm:LmLabel Content="DENOMINAÇÃO" Margin="0,8,0,4" />
      <lm:LmTextBox x:Name="txtDescricao" MaxLength="50" Height="30" LostFocus="TxtDenominacao_LostFocus" />

      <Grid x:Name="grdInfo" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <lm:LmLabel Style="{StaticResource Rotulo}" Content="Dimensão:" />
        <lm:LmLabel x:Name="lblEspess" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="1" Style="{StaticResource Rotulo}" Content="Material:" />
        <lm:LmLabel x:Name="lblMaterial" Grid.Row="1" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="2" Style="{StaticResource Rotulo}" Content="Código Material:" />
        <lm:LmLabel x:Name="lblCodMat" Grid.Row="2" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="3" Style="{StaticResource Rotulo}" Content="Descrição Material:" />
        <lm:LmLabel x:Name="lblDescMat" Grid.Row="3" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="4" Style="{StaticResource Rotulo}" Content="Peso:" />
        <lm:LmLabel x:Name="lblPeso" Grid.Row="4" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="5" Style="{StaticResource Rotulo}" Content="Processos:" />
        <lm:LmLabel x:Name="lblProcess" Grid.Row="5" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />
      </Grid>

      <lm:LmLabel Content="Material Chapa Metálica" Margin="0,8,0,4" />
      <lm:LmComboBox x:Name="txtMaterial"
                     Watermark="Selecionar Material Chapa Metálica"
                     DisplayMemberPath="DescricaoChapa"
                     SelectedValuePath="Id"
                     IsEditable="True"
                     IsTextSearchEnabled="True"
                     Height="30" />
    </StackPanel>

    <!-- Carregar, salvar e navegar entre componentes. -->
    <DockPanel Grid.Row="1" Margin="0,8,0,0">
      <lm:LmButton x:Name="btnCarregar" Style="{StaticResource BotaoIcone}" Icone="&#xE72C;" ToolTip="Carregar componentes para inserir processos" Click="BtnCarrProcess_Click" />
      <lm:LmButton x:Name="btnSalvar" Style="{StaticResource BotaoIcone}" Icone="&#xE74E;" ToolTip="Salvar Processos" Click="BtnSalvar_Click" />
      <lm:LmButton x:Name="btnAnterior" Style="{StaticResource BotaoIcone}" Icone="&#xE72B;" ToolTip="Peça anterior" Click="BtnVoltar_Click" />
      <lm:LmButton x:Name="btnProximo" Style="{StaticResource BotaoIcone}" Icone="&#xE72A;" ToolTip="Próxima peça" Click="BtnProximo_Click" />
      <lm:LmLabel x:Name="lblPecasProc" Content="Peça 0 de 0 - %" VerticalAlignment="Center" Margin="6,0,0,0" />
    </DockPanel>

    <lm:LmTabControl x:Name="tbcOperacoes" Grid.Row="2" Margin="0,8,0,0">
      <TabItem Header="Operações">
        <DockPanel Margin="0,6,0,0">
          <lm:LmTextBox x:Name="txtProcurar"
                        DockPanel.Dock="Top"
                        Watermark="Procurar operação..."
                        MaxLength="30"
                        MostrarBotaoLimpar="True"
                        Height="30"
                        Margin="0,0,0,6"
                        TextChanged="TxtProcurar_TextChanged" />

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstOperacoes" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="fundo"
                          Margin="2,1"
                          Padding="4,2"
                          CornerRadius="3"
                          Background="Transparent"
                          Visibility="{Binding Visivel, Converter={StaticResource BoolVisibilidade}}">
                    <lm:LmCheckBox Content="{Binding Texto}" IsChecked="{Binding Marcado}" />
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Marcado}" Value="True">
                      <Setter TargetName="fundo" Property="Background" Value="SpringGreen" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Lista Componentes">
        <lm:LmDataGrid x:Name="dgv"
                       Margin="0,6,0,0"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       SelectionMode="Single"
                       CanUserSortColumns="False"
                       CanUserResizeColumns="True"
                       HorizontalScrollBarVisibility="Auto"
                       MinRowHeight="30"
                       TextoSemRegistros="Clique em 'Carregar' com uma peça ou montagem aberta."
                       LoadingRow="Dgv_LoadingRow"
                       SelectionChanged="Dgv_SelectionChanged">
          <lm:LmDataGrid.Columns>
            <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Image Source="{Binding Img3D, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Abrir 3D" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Image Source="{Binding Img2D, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Abrir 2D" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Image Source="{Binding ImgFantasma, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Item Fantasma" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Image Source="{Binding ImgPendencia, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Pendências" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Nível" Binding="{Binding Nivel}" Width="80" MinWidth="50" />
            <DataGridTextColumn Header="Nome Componente" Binding="{Binding Name}" Width="180" MinWidth="80" />
            <DataGridTextColumn Header="Cód Produto" Binding="{Binding CodProduto}" Width="130" MinWidth="80" />
            <DataGridTextColumn Header="Descrição Produto" Binding="{Binding Denominacao}" Width="320" MinWidth="120" />
            <DataGridTextColumn Header="Referência" Binding="{Binding Referencia}" Width="200" MinWidth="80" />
          </lm:LmDataGrid.Columns>
        </lm:LmDataGrid>
      </TabItem>
    </lm:LmTabControl>
  </Grid>
</lm:LmView>
