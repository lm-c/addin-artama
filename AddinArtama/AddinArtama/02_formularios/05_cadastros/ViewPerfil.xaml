<lm:LmView x:Class="AddinArtama.ViewPerfil"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
           Titulo="Cadastro de Perfil do Usuário"
           MostrarBotaoAjuda="True"
           AjudaClick="LmView_AjudaClick">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition MinHeight="80" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel x:Name="pnlCadastro">
      <lm:LmLabel Content="Código" Tamanho="Medium" Margin="0,6,0,4" />
      <lm:LmTextBox x:Name="txtID"
                    Valor="Num_Inteiro"
                    Watermark="Novo"
                    IconeF7="&#xE721;"
                    ToolTipF7="Pesquisar [F7]"
                    Height="30"
                    BotaoF7Click="TxtID_BotaoF7Click"
                    LostFocus="TxtID_LostFocus"
                    PreviewKeyDown="TxtID_PreviewKeyDown" />

      <lm:LmLabel Content="Descrição *" Tamanho="Medium" Margin="0,10,0,4" />
      <lm:LmTextBox x:Name="txtDescricao" CampoObrigatorio="True" MaxLength="80" Height="30" />

      <lm:LmLabel Content="Observação" Tamanho="Medium" Margin="0,10,0,4" />
      <lm:LmTextBox x:Name="txtObservacao"
                    MaxLength="250"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    Height="70" />

      <lm:LmButton x:Name="btnPermissao"
                   Content="_Definir Permissões"
                   Icone="&#xE72E;"
                   HorizontalAlignment="Left"
                   Height="30"
                   Margin="0,10,0,0"
                   IsEnabled="False"
                   Click="BtnPermissao_Click" />
    </StackPanel>

    <!-- Usuários ativos que usam este perfil. -->
    <lm:LmGroupBox Grid.Row="1" Header="Usuários" Padding="6" Margin="0,10,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="lstUsuarios" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <lm:LmLabel Content="{Binding}" Tamanho="Medium" Margin="2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </lm:LmGroupBox>

    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
      <lm:LmButton Content="_Salvar" Icone="&#xE74E;" Width="100" Margin="0,0,6,6" IsDefault="True" Click="BtnSalvar_Click" />
      <lm:LmButton Content="_Limpar" Icone="&#xE894;" Estilo="Gray" Width="100" Margin="0,0,6,6" Click="BtnLimpar_Click" />
      <lm:LmButton x:Name="btnExcluir" Content="E_xcluir" Icone="&#xE74D;" Estilo="Gray" Width="100" Margin="0,0,6,6"
                   IsEnabled="False" Click="BtnExcluir_Click" />
    </WrapPanel>
  </Grid>
</lm:LmView>
