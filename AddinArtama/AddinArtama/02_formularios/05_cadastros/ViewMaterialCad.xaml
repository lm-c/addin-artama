<lm:LmView x:Class="AddinArtama.ViewMaterialCad"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
           Titulo="Cadastro de Material">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <lm:LmLabel Content="Código" Tamanho="Medium" Margin="0,6,0,4" />
      <lm:LmTextBox x:Name="txtID"
                    Valor="Num_Inteiro"
                    Watermark="Novo"
                    IconeF7="&#xE721;"
                    ToolTipF7="Pesquisar [F7]"
                    Height="30"
                    BotaoF7Click="TxtID_BotaoF7Click"
                    LostFocus="TxtID_LostFocus"
                    PreviewKeyDown="TxtID_PreviewKeyDown" />

      <lm:LmLabel Content="Descrição *" Tamanho="Medium" Margin="0,10,0,4" />
      <lm:LmTextBox x:Name="txtDescricao"
                    CampoObrigatorio="True"
                    MaxLength="250"
                    Height="30" />

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <lm:LmLabel Content="Situação" Tamanho="Medium" VerticalAlignment="Center" Margin="0,0,12,0" />
        <lm:LmCheckBox x:Name="ckbSituacao" Content="Ativo" IsChecked="True" VerticalAlignment="Center" />
      </StackPanel>

      <WrapPanel Margin="0,14,0,0">
        <lm:LmButton Content="_Salvar"
                     Icone="&#xE74E;"
                     Width="110"
                     Margin="0,0,8,6"
                     IsDefault="True"
                     Click="BtnSalvar_Click" />
        <lm:LmButton Content="_Limpar"
                     Icone="&#xE894;"
                     Estilo="Gray"
                     Width="110"
                     Margin="0,0,8,6"
                     Click="BtnLimpar_Click" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</lm:LmView>
