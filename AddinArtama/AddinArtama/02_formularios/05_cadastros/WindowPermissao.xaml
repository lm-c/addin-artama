<lm:LmWindow x:Class="AddinArtama.WindowPermissao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
             Title="Definir Permissões do Perfil"
             Width="460"
             Height="620"
             MostrarMinimizar="False"
             ShowInTaskbar="False">
  <lm:LmView MostrarCabecalho="False" FecharComEsc="False">
    <DockPanel Margin="4">
      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <lm:LmButton DockPanel.Dock="Right"
                     Content="_Salvar e Fechar"
                     Icone="&#xE74E;"
                     IsDefault="True"
                     Height="30"
                     Click="BtnSalvar_Click" />
        <StackPanel Orientation="Horizontal">
          <lm:LmButton Content="_Marcar Todos" Icone="&#xE73A;" Estilo="Gray" Height="30" Click="BtnMarcar_Click" />
          <lm:LmButton Content="_Desmarcar Todos" Icone="&#xE739;" Estilo="Gray" Height="30" Margin="6,0,0,0" Click="BtnDesmarcar_Click" />
        </StackPanel>
      </DockPanel>

      <TreeView x:Name="trvPermissoes" BorderThickness="1" Padding="4">
        <TreeView.ItemContainerStyle>
          <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Padding" Value="1,2" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Filhos}">
            <StackPanel Orientation="Horizontal">
              <lm:LmCheckBox IsChecked="{Binding Marcado}"
                             VerticalAlignment="Center"
                             Click="CkbPermissao_Click" />
              <Image Source="{Binding Imagem}" Width="16" Height="16" Margin="2,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Descricao}" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </DockPanel>
  </lm:LmView>
</lm:LmWindow>
