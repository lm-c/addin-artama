<lm:LmView x:Class="AddinArtama.ViewFormatosAtualizar"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
           Titulo="Atualizar Templates dos Desenhos">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,8">
      <WrapPanel>
        <lm:LmButton x:Name="btnCarregar" Content="Carregar Desenhos" Icone="&#xE72C;" Height="30" Margin="0,0,6,0"
                     Click="BtnCarrDesenhos_Click" />
        <lm:LmButton x:Name="btnAtualizar" Content="Iniciar Atualização" Icone="&#xE895;" Height="30"
                     ToolTip="Atualiza a partir da linha selecionada" Click="BtnAtualizar_Click" />
      </WrapPanel>

      <lm:LmTextBox x:Name="txtPesquisar"
                    Watermark="Pesquisar componente ou denominação"
                    IconeF7="&#xE721;"
                    ToolTipF7="Próximo resultado [F7]"
                    Height="30"
                    Margin="0,8,0,0"
                    BotaoF7Click="TxtPesquisar_BotaoF7Click"
                    PreviewKeyDown="TxtPesquisar_PreviewKeyDown" />
    </StackPanel>

    <lm:LmDataGrid x:Name="dgv"
                   AutoGenerateColumns="False"
                   SelectionMode="Single"
                   CanUserAddRows="False"
                   CanUserDeleteRows="False"
                   CanUserSortColumns="False"
                   TextoSemRegistros="Carregue os desenhos da montagem.">
      <lm:LmDataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Selecionar Todos" Click="TsmSelectAll_Click" />
          <MenuItem Header="Remover Seleção Todos" Click="TsmUnselectAll_Click" />
          <Separator />
          <MenuItem Header="Abrir 3D" Click="TsmOpen3D_Click" />
          <MenuItem Header="Abrir 2D" Click="TsmOpen2D_Click" />
        </ContextMenu>
      </lm:LmDataGrid.ContextMenu>
      <lm:LmDataGrid.Columns>
        <DataGridTemplateColumn Header="-" Width="40" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <lm:LmCheckBox IsChecked="{Binding Atualizar, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="COMPONENTE" Binding="{Binding ShortName}" Width="140" IsReadOnly="True" />
        <DataGridTextColumn Header="DENOMINAÇÃO" Binding="{Binding Denominacao}" Width="*" IsReadOnly="True" />
      </lm:LmDataGrid.Columns>
    </lm:LmDataGrid>
  </DockPanel>
</lm:LmView>
