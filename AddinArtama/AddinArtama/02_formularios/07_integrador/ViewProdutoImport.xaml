<lm:LmView x:Class="AddinArtama.ViewProdutoImport"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
           xmlns:local="clr-namespace:AddinArtama"
           Titulo="Cadastro de Produto/Engenharia">
  <lm:LmView.Resources>
    <local:BitmapParaImagemConverter x:Key="BitmapParaImagem" />
    <Style x:Key="Rotulo" TargetType="{x:Type lm:LmLabel}">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="Padding" Value="0,1,6,1" />
    </Style>
    <Style x:Key="Valor" TargetType="{x:Type lm:LmLabel}">
      <Setter Property="Negrito" Value="True" />
      <Setter Property="Padding" Value="0,1" />
    </Style>
  </lm:LmView.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- Dados do componente atual. -->
    <StackPanel x:Name="pnlDados">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <lm:LmLabel Style="{StaticResource Rotulo}" Content="Código Produto:" />
        <lm:LmLabel x:Name="lblCodigoProduto" Grid.Column="1" Style="{StaticResource Valor}" Content="---"
                    Cursor="Hand" ToolTip="Clique para Copiar" MouseLeftButtonUp="LblCodigoProduto_Click" />

        <lm:LmLabel Grid.Row="1" Style="{StaticResource Rotulo}" Content="Dimensão:" />
        <lm:LmLabel x:Name="lblEspess" Grid.Row="1" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="2" Style="{StaticResource Rotulo}" Content="Código Material:" />
        <lm:LmLabel x:Name="lblCodMat" Grid.Row="2" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="3" Style="{StaticResource Rotulo}" Content="Descrição Material:" />
        <lm:LmLabel x:Name="lblDescMat" Grid.Row="3" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <!-- Material errado: pisca e, ao clicar, permite escolher a chapa correta. -->
        <Image x:Name="ptbMaterialError" Grid.Row="2" Grid.RowSpan="2" Grid.Column="2"
               Width="28" Height="28" Margin="6,0,0,0" Cursor="Hand"
               ToolTip="Alterar Material" Visibility="Collapsed"
               MouseLeftButtonUp="PtbMaterialError_Click" />

        <lm:LmLabel Grid.Row="4" Style="{StaticResource Rotulo}" Content="Peso Bruto:" />
        <lm:LmLabel x:Name="lblPesoBrut" Grid.Row="4" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />

        <lm:LmLabel Grid.Row="5" Style="{StaticResource Rotulo}" Content="Peso NBR:" />
        <lm:LmLabel x:Name="lblPesoNbr" Grid.Row="5" Grid.Column="1" Style="{StaticResource Valor}" Content="---" />
      </Grid>

      <lm:LmLabel Content="Denominação" Margin="0,8,0,4" />
      <lm:LmTextBox x:Name="txtDescricao" MaxLength="50" Height="30" LostFocus="TxtDenominacao_LostFocus" />

      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="8" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <lm:LmLabel Content="SM Larg." Margin="0,0,0,4" />
        <lm:LmTextBox x:Name="txtSmLarg" Grid.Row="1" Valor="Num_Real" MaxLength="50" Height="30" LostFocus="TxtSmLarg_LostFocus" />

        <lm:LmLabel Grid.Column="2" Content="SM Compr." Margin="0,0,0,4" />
        <lm:LmTextBox x:Name="txtSmCompr" Grid.Row="1" Grid.Column="2" Valor="Num_Real" MaxLength="50" Height="30" LostFocus="TxtSmCompr_LostFocus" />

        <lm:LmButton x:Name="btnCarrProcess" Grid.Row="2" Content="Carregar" Icone="&#xE72C;" Height="32" Margin="0,8,0,0"
                     ToolTip="Carregar componentes" Click="BtnCarrProcess_Click" />
        <lm:LmButton x:Name="btnSalvar" Grid.Row="2" Grid.Column="2" Content="Salvar" Icone="&#xE74E;" Height="32" Margin="0,8,0,0"
                     ToolTip="Salvar/Atualizar Produto e Engenharia" Click="BtnSalvar_Click" />
      </Grid>
    </StackPanel>

    <TextBlock x:Name="lblWarning" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="Bold" Visibility="Collapsed" />

    <lm:LmTabControl x:Name="tbcOperacoes" Grid.Row="2" Margin="0,8,0,0">
      <TabItem Header="Componentes">
        <DockPanel Margin="0,6,0,0">
          <lm:LmTextBox x:Name="txtProcurar"
                        DockPanel.Dock="Top"
                        Watermark="Procurar..."
                        MostrarBotaoLimpar="True"
                        Height="30"
                        Margin="0,0,0,6"
                        TextChanged="TxtProcurar_TextChanged" />

          <lm:LmDataGrid x:Name="dgv"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserSortColumns="False"
                         CanUserResizeColumns="True"
                         HorizontalScrollBarVisibility="Auto"
                         MinRowHeight="30"
                         TextoSemRegistros="Clique em 'Carregar' com uma peça ou montagem aberta."
                         LoadingRow="Dgv_LoadingRow"
                         SelectionChanged="Dgv_SelectionChanged">
            <lm:LmDataGrid.Columns>
              <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Image Source="{Binding Img3D, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Abrir 3D" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Image Source="{Binding Img2D, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Abrir 2D" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Image Source="{Binding ImgFantasma, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Item Fantasma" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header=" " Width="38" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Image Source="{Binding ImgPendencia, Converter={StaticResource BitmapParaImagem}}" Width="22" Height="22" ToolTip="Pendências" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Nível" Binding="{Binding Nivel}" Width="80" MinWidth="50" />
              <DataGridTextColumn Header="Nome Componente" Binding="{Binding Name}" Width="180" MinWidth="80" />
              <DataGridTextColumn Header="Cód Produto" Binding="{Binding CodProduto}" Width="130" MinWidth="80" />
              <DataGridTextColumn Header="Descrição Produto" Binding="{Binding Denominacao}" Width="320" MinWidth="120" />
              <DataGridTextColumn Header="Referência" Binding="{Binding Referencia}" Width="200" MinWidth="80" />
            </lm:LmDataGrid.Columns>
          </lm:LmDataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Engenharia">
        <TreeView x:Name="trvProduto" Margin="0,6,0,0" BorderThickness="1" Padding="4">
          <TreeView.ItemContainerStyle>
            <Style TargetType="{x:Type TreeViewItem}">
              <Setter Property="IsExpanded" Value="True" />
              <Setter Property="Padding" Value="1,2" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Filhos}">
              <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Imagem}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </TabItem>
    </lm:LmTabControl>
  </Grid>
</lm:LmView>
