<lm:LmWindow x:Class="AddinArtama.WindowConfigIntegrador"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
             Title="Configuração de Integração"
             Width="560"
             Height="780"
             MostrarMinimizar="False"
             ShowInTaskbar="False"
             FecharComEsc="True">
  <lm:LmWindow.Resources>
    <Style x:Key="Rotulo" TargetType="{x:Type lm:LmLabel}">
      <Setter Property="Tamanho" Value="Medium" />
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style TargetType="{x:Type lm:LmTextBox}">
      <Setter Property="Height" Value="30" />
    </Style>
  </lm:LmWindow.Resources>

  <lm:LmView MostrarCabecalho="False" FecharComEsc="False">
    <DockPanel Margin="4">
      <lm:LmButton DockPanel.Dock="Bottom"
                   Content="_Salvar"
                   Icone="&#xE74E;"
                   IsDefault="True"
                   Width="120"
                   Height="30"
                   HorizontalAlignment="Right"
                   Margin="0,10,0,0"
                   Click="BtnSalvar_Click" />

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- API -->
          <lm:LmGroupBox Header="API" Padding="8,2,8,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <lm:LmLabel Content="Código Empresa" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtCodEmpresa" Grid.Row="1" Valor="Num_Inteiro" MaxLength="2" />

              <lm:LmLabel Grid.Column="2" Content="Endereço" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtEndereco" Grid.Row="1" Grid.Column="2" MaxLength="250" />

              <lm:LmLabel Grid.Row="2" Grid.ColumnSpan="3" Content="Token Consistem" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtToken" Grid.Row="3" Grid.ColumnSpan="3" MaxLength="500" />

              <lm:LmLabel Grid.Row="4" Grid.ColumnSpan="3" Content="Chave eDrawings" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtEDrawings" Grid.Row="5" Grid.ColumnSpan="3" MaxLength="500" />
            </Grid>
          </lm:LmGroupBox>

          <!-- Máscara -->
          <lm:LmGroupBox Header="Mascara" Padding="8,2,8,8" Margin="0,8,0,0">
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <lm:LmLabel Content="Mascara Peca" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtMascaraPeca" MaxLength="15" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <lm:LmLabel Content="Mascara Conjunto" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtMascaraConjunto" MaxLength="15" />
              </StackPanel>
            </UniformGrid>
          </lm:LmGroupBox>

          <!-- Dados do produto -->
          <lm:LmGroupBox Header="Dados do Produto" Padding="8,2,8,8" Margin="0,8,0,0">
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <lm:LmLabel Content="Classificação Fiscal" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtClassificacaoFiscal" Valor="Num_Inteiro" MaxLength="10" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <lm:LmLabel Content="Finalidade do Material" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtFinalidade" Valor="Num_Inteiro" MaxLength="10" />
              </StackPanel>
              <StackPanel Margin="0,0,6,0">
                <lm:LmLabel Content="Classificação Quanto a Origem" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtOrigem" Valor="Num_Inteiro" MaxLength="10" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <lm:LmLabel Content="% IPI" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtIpiPerc" Valor="Num_Real" MaxLength="10" />
              </StackPanel>
              <StackPanel Margin="0,0,6,0">
                <lm:LmLabel Content="Tipo Controle Saída" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtControleSaida" Valor="Num_Inteiro" MaxLength="10" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <lm:LmLabel Content="Código Conta Contábil" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtContaContabil" MaxLength="10" />
              </StackPanel>
              <StackPanel Margin="0,0,6,0">
                <lm:LmLabel Content="Localização Entrada" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtLocalizEntrada" Valor="Num_Inteiro" MaxLength="10" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <lm:LmLabel Content="Localização Saída" Style="{StaticResource Rotulo}" />
                <lm:LmTextBox x:Name="txtLocalizSaida" Valor="Num_Inteiro" MaxLength="10" />
              </StackPanel>
            </UniformGrid>
          </lm:LmGroupBox>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </lm:LmView>
</lm:LmWindow>
