<lm:LmView x:Class="AddinArtama.ViewManutProps"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
           Titulo="Manutenção Packlist e Plano de Pintura">
  <StackPanel MaxWidth="360" HorizontalAlignment="Left">
    <TextBlock x:Name="lblInfo"
               TextWrapping="Wrap"
               FontSize="14"
               Margin="0,10,0,0"
               Text="Esta manutenção removerá as propriedades &quot;PINTURA&quot; e &quot;CHECK&quot; da aba &quot;Específico da configuração&quot; da tela &quot;Propriedades do arquivo&quot;." />

    <lm:LmButton x:Name="btnIniciar"
                 Content="Iniciar Manutenção"
                 Icone="&#xE90F;"
                 Height="34"
                 Margin="0,16,0,0"
                 HorizontalAlignment="Left"
                 Click="BtnIniciar_Click" />
  </StackPanel>
</lm:LmView>
