<lm:LmWindow x:Class="AddinArtama.WindowConfigTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lm="http://schemas.lm.app.br/corbie-ui/wpf"
             Title="Configurar Templates"
             Width="860"
             Height="640"
             MostrarMinimizar="False"
             ShowInTaskbar="False"
             FecharComEsc="True">
  <lm:LmWindow.Resources>
    <Style x:Key="Rotulo" TargetType="{x:Type lm:LmLabel}">
      <Setter Property="Tamanho" Value="Medium" />
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <!-- Caminho do arquivo: só muda pelo botão de procurar (F7). -->
    <Style x:Key="Arquivo" TargetType="{x:Type lm:LmTextBox}">
      <Setter Property="Height" Value="30" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IconeF7" Value="&#xE8E5;" />
      <Setter Property="ToolTipF7" Value="Procurar arquivo [F7]" />
    </Style>
    <!-- Nome do formato de folha (.slddrt) gerado a partir do template escolhido. -->
    <Style x:Key="Formato" TargetType="{x:Type lm:LmTextBox}">
      <Setter Property="Height" Value="30" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </lm:LmWindow.Resources>

  <lm:LmView MostrarCabecalho="False" FecharComEsc="False">
    <DockPanel Margin="4">
      <lm:LmButton DockPanel.Dock="Bottom"
                   Content="_Salvar"
                   Icone="&#xE74E;"
                   IsDefault="True"
                   Width="120"
                   Height="30"
                   HorizontalAlignment="Right"
                   Margin="0,10,0,0"
                   Click="BtnSalvar_Click" />

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <lm:LmGroupBox Header="Formatos de Folha" Padding="8,2,8,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <lm:LmLabel Grid.Row="0" Content="Formato A4 Retrato" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtA4R" Grid.Row="1" Style="{StaticResource Arquivo}" BotaoF7Click="TxtFormato_BotaoF7Click" />
              <lm:LmTextBox x:Name="lblA4R" Grid.Row="1" Grid.Column="1" Style="{StaticResource Formato}" />

              <lm:LmLabel Grid.Row="2" Content="Formato A4 Paisagem" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtA4P" Grid.Row="3" Style="{StaticResource Arquivo}" BotaoF7Click="TxtFormato_BotaoF7Click" />
              <lm:LmTextBox x:Name="lblA4P" Grid.Row="3" Grid.Column="1" Style="{StaticResource Formato}" />

              <lm:LmLabel Grid.Row="4" Content="Formato A3" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtA3" Grid.Row="5" Style="{StaticResource Arquivo}" BotaoF7Click="TxtFormato_BotaoF7Click" />
              <lm:LmTextBox x:Name="lblA3" Grid.Row="5" Grid.Column="1" Style="{StaticResource Formato}" />

              <lm:LmLabel Grid.Row="6" Content="Formato A2" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtA2" Grid.Row="7" Style="{StaticResource Arquivo}" BotaoF7Click="TxtFormato_BotaoF7Click" />
              <lm:LmTextBox x:Name="lblA2" Grid.Row="7" Grid.Column="1" Style="{StaticResource Formato}" />

              <lm:LmLabel Grid.Row="8" Content="Formato A1" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtA1" Grid.Row="9" Style="{StaticResource Arquivo}" BotaoF7Click="TxtFormato_BotaoF7Click" />
              <lm:LmTextBox x:Name="lblA1" Grid.Row="9" Grid.Column="1" Style="{StaticResource Formato}" />

              <lm:LmLabel Grid.Row="10" Content="Formato A0" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtA0" Grid.Row="11" Style="{StaticResource Arquivo}" BotaoF7Click="TxtFormato_BotaoF7Click" />
              <lm:LmTextBox x:Name="lblA0" Grid.Row="11" Grid.Column="1" Style="{StaticResource Formato}" />
            </Grid>
          </lm:LmGroupBox>

          <lm:LmGroupBox Header="Listas de Material" Padding="8,2,8,8" Margin="0,8,0,0">
            <StackPanel>
              <lm:LmLabel Content="Lista de Montagem" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtListaMotagem" Style="{StaticResource Arquivo}" BotaoF7Click="TxtListaMotagem_BotaoF7Click" />

              <lm:LmLabel Content="Lista de Soldagem" Style="{StaticResource Rotulo}" />
              <lm:LmTextBox x:Name="txtListaSoldagem" Style="{StaticResource Arquivo}" BotaoF7Click="TxtListaSoldagem_BotaoF7Click" />
            </StackPanel>
          </lm:LmGroupBox>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </lm:LmView>
</lm:LmWindow>
